@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c0c0c;--card:#161616;--line:#3a3a3a;--tx:#f2f2ef;--mu:#a3a39e;--dot:#ffffff1f;--empty:#3a3a3a;--red:#ff4d55;--o:#ff8a4c;--b:#4dabf7;--g:#51cf66;--v:#9775fa;--y:#ffd43b;--h0:#ff4d55;--h1:#ff8a4c;--h2:#51cf66;--h3:#4dabf7;--h4:#9775fa;--h5:#f06595;--h6:#3bc9db;--h7:#d9a37a;--h8:#a9d44a;--h9:#adb5bd;color-scheme:dark}}
