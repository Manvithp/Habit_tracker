.quote{padding:20px;border-radius:24px;color:#fff;cursor:pointer;min-height:160px;display:flex;flex-direction:column;justify-content:center;text-align:center}
.quote b{font-size:19px;line-height:1.3}.quote i{font-style:normal;opacity:.9;margin-top:10px;font-size:12px}
.btn{background:transparent;border:1.5px solid var(--tx);color:var(--tx);padding:9px 14px;border-radius:999px;cursor:pointer;font:inherit;display:flex;gap:8px;align-items:center;justify-content:center}
.btn:hover{background:var(--tx);color:var(--bg)}.btn.p{background:var(--red);border-color:var(--red);color:#fff}
.bar{display:flex;justify-content:space-between;gap:2px}.bar i{flex:1;max-width:10px;aspect-ratio:1;border-radius:50%;background:var(--empty)}.bar i.f{background:var(--c,var(--red))}
.row{display:flex;align-items:center;gap:10px}.row .bar{flex:1}.sp{justify-content:space-between}.mb{margin-bottom:12px}
.top{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:12px}
.top h1{flex:1 1 auto;min-width:0;font-size:clamp(26px,3.8vw,46px);font-weight:700;letter-spacing:-.04em;line-height:1.05;display:flex;align-items:center}.top>.row{margin-left:auto}.rt{color:var(--red)}.rd{flex:none;width:.34em;height:.34em;border-radius:50%;background:var(--red);margin-right:.35em}
.tabs{display:flex;gap:4px;background:var(--card);padding:3px;border-radius:999px;border:1.5px solid var(--tx);overflow:auto}
.tab{padding:6px 14px;border-radius:999px;border:0;background:0;color:var(--mu);cursor:pointer;font:inherit;white-space:nowrap}
.tab.on{background:var(--tx);color:var(--bg)}
.nav{display:flex;gap:6px;align-items:center;margin-bottom:12px}.nav .btn{padding:6px 14px}.nav b{flex:1;font-size:15px}
