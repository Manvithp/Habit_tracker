.chips button.on{background:var(--tx);color:var(--bg)}
svg text{fill:var(--mu);font-size:12px}.row .tabs{min-width:0}
.hmw{overflow:auto}.hm{display:grid;grid-auto-flow:column;grid-template-rows:repeat(7,15px);gap:3px;width:max-content}
.hm i{width:15px;height:15px;border-radius:50%;cursor:pointer}
.wd{display:flex;gap:8px;align-items:flex-end;height:150px}.wd div{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;font-size:11px;color:var(--mu);gap:4px}.wd i{width:100%;border-radius:10px 10px 4px 4px;min-height:3px}
