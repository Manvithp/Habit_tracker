input{background:var(--bg);border:1.5px solid var(--tx);color:var(--tx);border-radius:12px;padding:8px;font:inherit}
.hi{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line)}.hi span{flex:1}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--tx);color:var(--bg);padding:10px 18px;border-radius:999px;font-weight:700;opacity:0;pointer-events:none;transition:opacity .3s}#toast.on{opacity:1}
button:focus-visible,input:focus-visible{outline:2px solid var(--b);outline-offset:2px}

.tl{max-height:200px;overflow:auto}.ti{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line)}.ti span{flex:1;word-break:break-word}.ti.dn span{color:var(--mu);text-decoration:line-through}
.tc{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--tx);background:0;color:var(--bg);cursor:pointer;font-size:11px;flex:none;padding:0}.tc.on{background:var(--g);border-color:var(--g)}
.tr{border:0;background:0;color:var(--mu);cursor:pointer;font:inherit;font-size:16px;padding:0 4px}
#blip{position:fixed;left:0;top:0;z-index:40;width:72px;height:72px;padding:0;border:0;background:none;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;transform:translate(24px,120px);will-change:transform}
.bs{display:block;transform-origin:50% 100%;animation:bob 3.2s ease-in-out infinite}.bs svg{display:block;overflow:visible}.bs.hop{animation:hop .9s ease-out}
@keyframes bob{50%{transform:translateY(-2px) scale(1.02,.98)}}
@keyframes hop{0%{transform:scale(1.12,.84)}35%{transform:translateY(-16px) scale(.92,1.1)}70%{transform:scale(1.1,.88)}100%{transform:none}}
.bk{transform-box:fill-box;transform-origin:center;animation:bl 5s infinite}@keyframes bl{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.1)}}
.sk{animation:tw 2.4s ease-in-out infinite}@keyframes tw{50%{opacity:.25}}
.bb{position:absolute;bottom:100%;left:50%;margin-bottom:9px;width:max-content;max-width:190px;transform:translateX(-50%) scale(.85);opacity:0;transition:opacity .25s,transform .25s;background:var(--card);color:var(--tx);border:1.5px solid var(--tx);border-radius:14px;padding:6px 10px;font:12px/1.35 "Space Mono",monospace;text-align:center;pointer-events:none}
.bb.on{opacity:1;transform:translateX(-50%) scale(1)}
.bb:after{content:"";position:absolute;left:50%;bottom:-6px;width:9px;height:9px;background:var(--card);border:solid var(--tx);border-width:0 1.5px 1.5px 0;transform:translateX(-50%) rotate(45deg)}
.dd{display:inline-flex;gap:4px;padding:2px 0}.dd i{width:6px;height:6px;border-radius:50%;background:var(--tx);animation:dt 1s infinite}.dd i:nth-child(2){animation-delay:.15s}.dd i:nth-child(3){animation-delay:.3s}@keyframes dt{50%{opacity:.25;transform:translateY(-3px)}}
@media(prefers-reduced-motion:reduce){.bs,.bs.hop,.bk,.sk,.dd i{animation:none!important}}

.bs.dance{animation:dance .6s ease-in-out 4}@keyframes dance{0%,100%{transform:rotate(-9deg)}50%{transform:rotate(9deg) translateY(-9px)}}
.bs.squat{animation:squat 1s ease-in-out 3}@keyframes squat{0%,100%{transform:none}30%{transform:scale(1.12,.78)}60%{transform:translateY(-12px) scale(.92,1.1)}}
.bs.spin{animation:spin .9s ease-in-out}@keyframes spin{to{transform:rotate(360deg)}}
.bs.walk{animation:waddle .4s ease-in-out 6}@keyframes waddle{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg) translateY(-3px)}}
.bs.sleep{animation:snore 3s ease-in-out infinite}@keyframes snore{50%{transform:scale(1.04,.95)}}
#blip.sleep .bk{animation:none;transform:scaleY(.12)}
#blip.drag{cursor:grabbing}#blip.drag .bs{animation:dangle .5s ease-in-out infinite;transform-origin:50% 0}@keyframes dangle{0%,100%{transform:rotate(-7deg)}50%{transform:rotate(7deg)}}

.top{padding-right:92px;min-height:74px}
#home{position:fixed;top:max(10px,env(safe-area-inset-top));right:10px;width:80px;height:80px;z-index:30;pointer-events:none;border-radius:16px}#home.hot{outline:2px dashed var(--red);outline-offset:4px}
#blip.dk .bb{bottom:auto;top:100%;margin:9px 0 0;left:auto;right:0;transform:scale(.85);transform-origin:100% 0}#blip.dk .bb.on{transform:scale(1)}
#blip.dk .bb:after{bottom:auto;top:-6px;left:auto;right:28px;border-width:1.5px 0 0 1.5px;transform:rotate(45deg)}
</style></head><body>
