.kpi:nth-child(1) b{color:var(--red)}.kpi:nth-child(2) b{color:var(--o)}.kpi:nth-child(3) b{color:var(--b)}.kpi:nth-child(4) b{color:var(--g)}.kpi:nth-child(5) b{color:var(--v)}
