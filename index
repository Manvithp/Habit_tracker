*{box-sizing:border-box;margin:0}
body{font:13px/1.45 "Space Mono",ui-monospace,"SF Mono",Menlo,monospace;color:var(--tx);min-height:100vh;padding:max(14px,env(safe-area-inset-top)) 14px calc(40px + env(safe-area-inset-bottom,0px));background:var(--bg) radial-gradient(var(--dot) 1px,transparent 1.2px) 0 0/12px 12px}
.app{display:grid;grid-template-columns:290px 1fr;gap:16px;max-width:1400px;margin:auto}
@media(max-width:900px){.app{grid-template-columns:1fr}.main{order:1}.side{order:2}}
.side,.main{min-width:0}.side{display:flex;flex-direction:column;gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:14px}
